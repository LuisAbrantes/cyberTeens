# ==============================================================================
# CyberTeens Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon\r

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-workspace
.history/
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text / TextMate
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*~
*.swp
*.swo
.netrwhist
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]

# ------------------------------------------------------------------------------
# Node.js and Dependency Directories (Future-proofing)
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.npm/
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# Logs and Databases
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
*.sqlite
*.db

# ------------------------------------------------------------------------------
# Build and Output Directories (Future-proofing)
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.astro/

# ------------------------------------------------------------------------------
# Local Environment and Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.pem
*.key
*.cert
*.pfx
secrets/
credentials*.json

